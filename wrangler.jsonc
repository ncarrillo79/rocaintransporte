{
  // Deploy explicito: Worker de solo assets estaticos (sin script "main").
  // "wrangler deploy" sube ./dist tal cual, sin autodetectar el framework
  // (era la autodeteccion la que exigia Vite >= 6).
  "name": "rocaintransporte",
  "compatibility_date": "2026-09-09",
  // Mantiene activa la URL de prueba rocaintransporte.ncarrillo79.workers.dev.
  "workers_dev": true,
  // Dominios propios: wrangler los conecta (DNS + HTTPS) al desplegar.
  "routes": [
    { "pattern": "rocaintransporte.com", "custom_domain": true },
    { "pattern": "www.rocaintransporte.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // Rutas no encontradas -> index.html (red de seguridad; el router usa #/).
    "not_found_handling": "single-page-application"
  }
}
